# ─────────────────────────────────────────────────────────────
# 필수: 데이터베이스 (Vercel Marketplace 의 Neon/Postgres 연결 시 자동 주입됨)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────
# 필수: NextAuth
#   AUTH_SECRET 생성:  npx auth secret   (또는 openssl rand -base64 32)
#   NEXTAUTH_URL 은 Vercel 에서는 생략 가능
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="여기에_랜덤_시크릿"
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# 로그인 허용 도메인 (쉼표 구분, 비우면 모든 구글 계정 허용)
ALLOWED_EMAIL_DOMAINS="kaist.ac.kr"

# 관리자 이메일 (쉼표 구분) — 세미나실 관리 / 모든 예약 취소 권한
ADMIN_EMAILS="you@kaist.ac.kr"

# ─────────────────────────────────────────────────────────────
# 선택: 운영 정책
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TIME_ZONE="Asia/Seoul"
NEXT_PUBLIC_OPEN_HOUR="0"
NEXT_PUBLIC_CLOSE_HOUR="24"
NEXT_PUBLIC_SLOT_MINUTES="30"
MAX_DURATION_MINUTES="480"
MAX_ADVANCE_DAYS="365"
# 지난 예약 보관 기간(개월). 매일 한 번 크론이 이보다 오래된 예약을 삭제한다
RETENTION_MONTHS="12"

