# ─────────────────────────────────────────────────────────────
# 필수: 데이터베이스 (Vercel Marketplace 의 Neon/Postgres 연결 시 자동 주입됨)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────
# 필수: NextAuth
#   AUTH_SECRET 생성:  npx auth secret   (또는 openssl rand -base64 32)
#   NEXTAUTH_URL 은 Vercel 에서는 생략 가능
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="여기에_랜덤_시크릿"
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# 로그인 허용 도메인 (쉼표 구분, 비우면 모든 구글 계정 허용)
ALLOWED_EMAIL_DOMAINS="kaist.ac.kr"

# 관리자 이메일 (쉼표 구분) — 세미나실 관리 / 모든 예약 취소 권한
ADMIN_EMAILS="you@kaist.ac.kr"

# ─────────────────────────────────────────────────────────────
# 선택: 구글 캘린더 연동 (서비스 계정)
#   설정하지 않아도 예약 시스템은 정상 동작합니다.
#   GOOGLE_PRIVATE_KEY 는 개행을 \n 으로 바꿔 한 줄로 넣습니다.
# ─────────────────────────────────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_EMAIL="seminar-bot@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID="xxxxxxxx@group.calendar.google.com"

# ─────────────────────────────────────────────────────────────
# 선택: 운영 정책
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TIME_ZONE="Asia/Seoul"
NEXT_PUBLIC_OPEN_HOUR="0"
NEXT_PUBLIC_CLOSE_HOUR="24"
NEXT_PUBLIC_SLOT_MINUTES="30"
MAX_DURATION_MINUTES="480"
MAX_ADVANCE_DAYS="90"

# ICS 구독 피드에 토큰을 요구하려면 설정 (비우면 URL 을 아는 사람은 누구나 구독 가능)
# ICS_TOKEN="랜덤_문자열"
